generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ///////////////////
/// ///////////////////
model User {
  id                   Int             @id @default(autoincrement())
  name                 String
  email                String          @unique
  password             String?
  country              String?
  avatar               String?
  age                  Int?
  gender               Gender
  isSeller             Boolean         @default(false)
  isAdmin              Boolean         @default(false)
  provider             Provider        @default(LOCAL)
  providerId           String?
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  chats                AiChat[]
  notifications        Notification[]
  orders               Order[]
  reviews              Review[]
  sellerRequest        SellerRequest?
  store                Store?
  favorites            StoreFavorite[]
  follows              StoreFollow[]
  reports              ProductReport[]
  deviceTokens         UserDeviceToken[]
}

/// ///////////////////
/// ///////////////////
model Store {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  logo        String?
  image       String?
  type        StoreType       @default(SELLER)
  ownerId     Int             @unique
  isActive           Boolean   @default(true)
  deactivationReason String?
  createdAt          DateTime  @default(now())
  orderItems         OrderItem[]
  products           Product[]
  owner              User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favoritedBy        StoreFavorite[]
  followers          StoreFollow[]

  @@index([ownerId])
}

/// ///////////////////
/// ///////////////////
model SellerRequest {
  id              Int                 @id @default(autoincrement())
  userId          Int                 @unique
  storeName       String
  storeImage      String?
  message         String?
  productType     String?
  region          String?
  status          SellerRequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  processedAt     DateTime?
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// ///////////////////
/// ///////////////////
model AiChat {
  id        Int         @id @default(autoincrement())
  title     String
  userId    Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
}

model AiMessage {
  id        Int      @id @default(autoincrement())
  chatId    Int
  role      String
  content   String
  createdAt DateTime @default(now())
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

/// ///////////////////
/// ///////////////////
model Product {
  id               Int         @id @default(autoincrement())
  name             String
  shortDescription String?
  fullDescription  String?
  price            Float
  image            String
  stock            Int         @default(0)
  category         String
  badge            String?
  isHot            Boolean     @default(false)
  rating           Float?      @default(0)
  reviewsCount     Int?        @default(0)
  storeId          Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  isActive         Boolean     @default(true)
  orderItems       OrderItem[]
  store            Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reviews          Review[]
  reports          ProductReport[]

  @@index([storeId])
}

/// ///////////////////
/// ///////////////////
model Order {
  id              Int            @id @default(autoincrement())
  userId          Int
  total           Float
  status          OrderStatus    @default(PENDING)
  city            String?
  address         String?
  phone           String?
  adminStatus     AdminStatus    @default(ADMIN_PENDING)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  notifications   Notification[]
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payments        Payment[]

  @@index([userId])
  @@index([status])
  @@index([adminStatus])
}

/// ///////////////////
/// ///////////////////
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  imageUrl  String?
  productId Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

/// ///////////////////
/// ///////////////////
model OrderItem {
  id              Int             @id @default(autoincrement())
  orderId         Int
  productId       Int
  storeId         Int
  quantity        Int
  priceAtPurchase Float
  status          OrderItemStatus
  rejectReason    String?
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  refund          Refund?

  @@index([orderId])
  @@index([productId])
  @@index([storeId])
}

/// ///////////////////
/// ///////////////////
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  orderId   Int?
  createdAt DateTime         @default(now())
  order     Order?           @relation(fields: [orderId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
}

/// ///////////////////
/// ///////////////////
model Payment {
  id        Int           @id @default(autoincrement())
  orderId   Int
  userId    Int
  amount    Float
  method    String        @default("MOCK")
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds   Refund[]

  @@index([orderId])
  @@index([userId])
}

/// ///////////////////
/// ///////////////////
model Refund {
  id          Int       @id @default(autoincrement())
  orderItemId Int       @unique
  paymentId   Int
  amount      Float
  status      String    @default("REFUNDED")
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([paymentId])
}

model StoreFollow {
  id        Int      @id @default(autoincrement())
  userId    Int
  storeId   Int
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model StoreFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  storeId   Int
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

/// ///////////////////
/// ///////////////////
enum Gender {
  MALE
  FEMALE
}

enum Provider {
  LOCAL
  GOOGLE
}

enum StoreType {
  ADMIN
  SELLER
}

enum SellerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderItemStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SHIPPED
  DELIVERED
}

enum AdminStatus {
  ADMIN_PENDING
  ADMIN_APPROVED
  ADMIN_REJECTED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_APPROVED
  ORDER_REJECTED
  ORDER_ITEM_APPROVED
  ORDER_ITEM_REJECTED
  STORE_WARNING
  STORE_DEACTIVATED
  STORE_REACTIVATED
  PRODUCT_REPORTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  SHIPPED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model ProductReport {
  id        String   @id @default(uuid())
  message   String
  status    ReportStatus @default(PENDING)
  createdAt DateTime @default(now())

  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model AdminNotification {
  id        String   @id @default(uuid())
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ReportStatus {
  PENDING
  RESOLVED
}

model UserDeviceToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String?  // 'web' | 'android' | 'ios'
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @updatedAt

  @@index([userId])
}
